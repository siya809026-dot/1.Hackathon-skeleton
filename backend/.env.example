# Port the Express server listens on
PORT=5000

# MongoDB connection string
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/genhire
# MongoDB Atlas (cloud) example - replace with your own and keep it private:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/genhire?retryWrites=true&w=majority
